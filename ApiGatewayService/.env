# FastAPI Gateway Service - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
ENVIRONMENT=local

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# JWT Secret Key - Replace with your own secure key in production
JWT_SECRET=BvPHGM8C0ia4uOuxxqPD5DTbWC9F9TWvPStp3pb7ARo0oK2mJ3pd3YG4lxA9i8bj6OTbadwezxgeEByY
JWT_ALGORITHM=HS256

# ============================================================================
# EUREKA SERVICE DISCOVERY
# ============================================================================
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_APP_NAME=gateway-service

# ============================================================================
# UPSTREAM SERVICES CONFIGURATION
# ============================================================================
# Configure the URLs of your microservices
# For local development, use localhost:port
# For Docker, use container names or host.docker.internal:port
# For production, use proper service DNS names
USER_SERVICE_URL=http://localhost:8001
CONTRACT_SERVICE_URL=http://localhost:8002
ENTITY_SERVICE_URL=http://localhost:8003
TIMESHEET_SERVICE_URL=http://localhost:8004

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=https://smmc-io-prod.timesmart.io,http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
CORS_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin

# ============================================================================
# ACTUATOR CONFIGURATION
# ============================================================================
ACTUATOR_ENABLED=true

# ============================================================================
# REQUEST TIMEOUT
# ============================================================================
REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# DISTRIBUTED TRACING (Optional)
# ============================================================================
ZIPKIN_ENABLED=false
ZIPKIN_URL=http://localhost:9411/api/v2/spans
