# FastAPI Gateway Service - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_PORT=8000
SERVER_HOST=0.0.0.0
ENVIRONMENT=local

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# JWT Secret Key - Replace with your own secure key in production
JWT_SECRET=BvPHGM8C0ia4uOuxxqPD5DTbWC9F9TWvPStp3pb7ARo0oK2mJ3pd3YG4lxA9i8bj6OTbadwezxgeEByY
JWT_ALGORITHM=HS256

# ============================================================================
# EUREKA SERVICE DISCOVERY
# ============================================================================
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_APP_NAME=gateway-service

# ============================================================================
# FRONTEND CONFIGURATION (Matches Spring Gateway react-uri, flutter-uri)
# ============================================================================
REACT_URI=https://app.timesmartai.ca
FLUTTER_URI=https://app.timesmartai.ca

# ============================================================================
# BACKEND SERVICES CONFIGURATION (Domain-based, NOT IP:port)
# ============================================================================
# For local development: http://localhost:port or http://service-name:port
# For Docker: http://service-name:port (container names)
# For Kubernetes: http://service-name.namespace.svc.cluster.local:port
# For production: https://domain.com or use service discovery
USER_MANAGEMENT_SERVICE_URL=http://localhost:8001
CONTRACT_MANAGEMENT_SERVICE_URL=http://localhost:8002
ENTITY_SERVICE_URL=http://localhost:8003
TIMESHEET_MANAGEMENT_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=https://smmc-io-prod.timesmart.io,http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
CORS_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin

# ============================================================================
# ACTUATOR CONFIGURATION
# ============================================================================
ACTUATOR_ENABLED=true

# ============================================================================
# REQUEST TIMEOUT
# ============================================================================
REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# DISTRIBUTED TRACING (Optional)
# ============================================================================
ZIPKIN_ENABLED=false
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# ============================================================================
# KEYCLOAK/OAUTH2 CONFIGURATION
# ============================================================================
KEYCLOAK_ENABLED=true
KEYCLOAK_SERVER_URL=https://idm.timesmart.io
KEYCLOAK_REALM=smmc-io-prod
KEYCLOAK_CLIENT_ID=spring-addons-confidential
KEYCLOAK_CLIENT_SECRET=SIfNoIQ7aUnW6pvwT2I9YjYhZKhRIlUd
KEYCLOAK_REDIRECT_URI=https://smmc-io-prod.timesmart.io/login/oauth2/code/smmc-io-prod
POST_LOGIN_REDIRECT_PATH=/home/
POST_LOGOUT_REDIRECT_PATH=/

# POST_LOGIN_REDIRECT_PATH=/home/
# POST_LOGOUT_REDIRECT_PATH=/
