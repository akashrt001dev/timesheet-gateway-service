# ========================================================================
# FastAPI Gateway Configuration - OAuth2/Keycloak CORS Fixed
# ========================================================================
# Copy this to .env and customize for your environment

# ========================================================================
# SERVER CONFIGURATION
# ========================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO
APP_NAME=api-gateway-service

# ========================================================================
# FRONTEND CONFIGURATION
# ========================================================================
# React app URI (user's browser will navigate to this)
REACT_URI=https://app.timesmartai.ca

# Flutter app URI (user's browser will navigate to this)
FLUTTER_URI=https://app.timesmartai.ca

# ========================================================================
# CORS CONFIGURATION - CRITICAL FOR OAUTH2/KEYCLOAK
# ========================================================================
# IMPORTANT: Include Keycloak server URL to fix OAuth2 CORS issues
# Format: comma-separated list or wildcard "*"
# Examples:
#   - Specific origins: "https://app.timesmartai.ca,https://idm.timesmart.io"
#   - Wildcard (allow all): "*"
CORS_ORIGINS=https://app.timesmartai.ca,https://idm.timesmart.io

# Allow credentials (cookies, Authorization header, TLS client cert)
# REQUIRED for OAuth2 with Keycloak session-based auth
CORS_CREDENTIALS=true

# HTTP methods allowed in cross-origin requests
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS,HEAD

# Headers allowed in cross-origin requests
# Use "*" for all headers, or specify: "Content-Type,Authorization,X-Requested-With"
CORS_HEADERS=*

# ========================================================================
# KEYCLOAK / OAUTH2 CONFIGURATION
# ========================================================================
KEYCLOAK_ENABLED=true

# Keycloak server URL (must also be in CORS_ORIGINS)
KEYCLOAK_SERVER_URL=https://idm.timesmart.io

# Keycloak realm name
KEYCLOAK_REALM=smmc-uat-prod

# OAuth2 client ID (confidential client)
KEYCLOAK_CLIENT_ID=spring-addons-confidential

# OAuth2 client secret (keep this secret!)
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# OAuth2 redirect URI (callback URL after Keycloak login)
# This must match the URL configured in Keycloak client settings
KEYCLOAK_REDIRECT_URI=https://api.timesmart.io/login/oauth2/code/keycloak

# Where to redirect after successful login
POST_LOGIN_REDIRECT_PATH=/home/

# Where to redirect after logout
POST_LOGOUT_REDIRECT_PATH=/home
POST_LOGOUT_REDIRECT_URI=https://app.timesmartai.ca/home

# ========================================================================
# BACKEND SERVICES CONFIGURATION
# ========================================================================
# These can be:
# - Local: http://localhost:8001
# - Docker internal: http://user-service:8001
# - Kubernetes: http://user-service.namespace.svc.cluster.local:8001

USER_MANAGEMENT_SERVICE_URL=http://localhost:8001
CONTRACT_MANAGEMENT_SERVICE_URL=http://localhost:8002
ENTITY_SERVICE_URL=http://localhost:8003
TIMESHEET_MANAGEMENT_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
FEEDBACK_MANAGEMENT_SERVICE_URL=http://localhost:8007

# ========================================================================
# REQUEST CONFIGURATION
# ========================================================================
REQUEST_TIMEOUT_SECONDS=30

# ========================================================================
# JWT CONFIGURATION (if needed for internal validation)
# ========================================================================
JWT_SECRET=BvPHGM8C0ia4uOuxxqPD5DTbWC9F9TWvPStp3pb7ARo0oK2mJ3pd3YG4lxA9i8bj6OTbadwezxgeEByY
JWT_ALGORITHM=HS256

# ========================================================================
# DISTRIBUTED TRACING (Optional)
# ========================================================================
ZIPKIN_ENABLED=false
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# ========================================================================
# SERVICE DISCOVERY (Optional - Eureka for Spring Cloud)
# ========================================================================
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_APP_NAME=gateway-service

# ========================================================================
# ACTUATOR (Kubernetes/Docker monitoring)
# ========================================================================
ACTUATOR_ENABLED=true
